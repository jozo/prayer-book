require "base64"
require "fileutils"
require "json"
require "tmpdir"

default_platform(:ios)

# Fastfile code runs in fastlane/, actions run in the project root
ANDROID_METADATA = "metadata/android/en-US"

def app_version
  JSON.parse(File.read("../package.json"))["version"]
end

def android_version_code
  File.read("../android/app/build.gradle")[/versionCode (\d+)/, 1]
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID").strip,
    issuer_id: ENV.fetch("ASC_ISSUER_ID").strip,
    key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
    is_key_content_base64: true
  )
end

platform :android do
  desc "Upload the signed AAB, listing, release notes and screenshots to Google Play"
  lane :play_store do |options|
    track = options.fetch(:track, "internal")
    upload_to_play_store(
      json_key_data: ENV.fetch("GOOGLE_PLAY_JSON_KEY"),
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      track: track,
      # Internal testers get the build right away, like on TestFlight. On the other tracks the release
      # waits as a draft to be rolled out in the Play Console.
      release_status: track == "internal" ? "completed" : "draft",
      # The same listing as F-Droid, with the changelog of the current versionCode as release notes
      metadata_path: "fastlane/metadata/android",
      # The icon (512x512, rendered from resources/icon.svg) and the screenshots (taken with
      # "npm run screenshots"), uploading only the changed ones
      sync_image_upload: true
    )
  end
end

platform :ios do
  desc "Build the iOS app, upload it to TestFlight and update the App Store listing"
  lane :beta do
    project = "ios/App/App.xcodeproj"
    version = app_version

    key_id = ENV.fetch("ASC_KEY_ID").strip
    issuer_id = ENV.fetch("ASC_ISSUER_ID").strip
    key_content = ENV.fetch("ASC_KEY_P8_BASE64")
    api_key = asc_api_key

    # xcodebuild needs the key as a file to manage signing (-allowProvisioningUpdates)
    key_path = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
    File.write(key_path, Base64.decode64(key_content))
    signing_args = "-allowProvisioningUpdates " \
                   "-authenticationKeyPath #{key_path} " \
                   "-authenticationKeyID #{key_id} " \
                   "-authenticationKeyIssuerID #{issuer_id}"

    increment_version_number(version_number: version, xcodeproj: project)
    increment_build_number(
      build_number: latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1,
      xcodeproj: project
    )

    build_app(
      project: project,
      scheme: "App",
      export_method: "app-store",
      output_directory: "build/ios",
      # gym passes xcargs to the export step too
      xcargs: signing_args
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)

    app_store_listing
  end

  desc "Upload the App Store listing (from the Android metadata) and screenshots, without submitting for review"
  lane :app_store_listing do
    Dir.mktmpdir do |metadata_path|
      # Share the listing with Google Play and F-Droid. Fields without an Android counterpart
      # (subtitle, keywords, URLs) are left as they are in App Store Connect. The name under the
      # icon on the phone is CFBundleDisplayName, not this one.
      listing = {
        "name.txt" => "title.txt",
        "description.txt" => "full_description.txt",
        "promotional_text.txt" => "short_description.txt",
        "release_notes.txt" => "changelogs/#{android_version_code}.txt"
      }
      FileUtils.mkdir_p(File.join(metadata_path, "en-US"))
      listing.each do |ios_file, android_file|
        FileUtils.cp(File.join(ANDROID_METADATA, android_file), File.join(metadata_path, "en-US", ios_file))
      end

      upload_to_app_store(
        api_key: asc_api_key,
        app_version: app_version,
        metadata_path: metadata_path,
        # Taken with "npm run screenshots"
        screenshots_path: "fastlane/screenshots",
        overwrite_screenshots: true,
        skip_binary_upload: true,
        submit_for_review: false,
        # Don't wait for confirmation of the HTML preview
        force: true
      )
    end
  end
end
